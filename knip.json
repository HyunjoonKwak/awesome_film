{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/web": {
      "entry": [
        "src/app/**/{page,layout,loading,error,not-found,route}.tsx",
        "next.config.{js,mjs,ts}",
        "scripts/e2e-collab-server.mjs",
        "src/**/*.test.{ts,tsx}",
        "public/sw.js",
        "public/plugins/*.js"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "src/effects/plugin-registry.ts"
      ]
    },
    "apps/desktop": {
      "project": ["src/**/*.cjs"],
      "ignore": [
        "src/preload.cjs"
      ],
      "ignoreDependencies": [
        "cross-env"
      ]
    },
    "packages/core": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
