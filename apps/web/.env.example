# Required for realtime collaboration. Use wss:// outside localhost.
NEXT_PUBLIC_COLLAB_WS_URL=wss://collab.example.com
# Required for non-loopback relay URLs. This authenticated endpoint accepts
# POST { "room": "cut-editor:..." } and returns { "token": "short-lived-ticket" }.
NEXT_PUBLIC_COLLAB_TICKET_URL=https://app.example.com/api/collab-ticket
