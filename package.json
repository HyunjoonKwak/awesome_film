{
  "name": "cut-editor",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native, collaborative, web-first video editor — open alternative to Final Cut Pro and CapCut.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @cut/web dev",
    "build": "pnpm --filter @cut/web build",
    "start": "pnpm --filter @cut/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "pnpm -r format"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "knip": "^6.14.2"
  }
}
