{
  "name": "cut-editor",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native, collaborative, web-first video editor — open alternative to Final Cut Pro and CapCut.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @cut/web dev",
    "build": "pnpm --filter @cut/web build",
    "start": "pnpm --filter @cut/web start",
    "lint": "pnpm -r lint && biome lint scripts",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @cut/web test:e2e",
    "audit:prod": "node scripts/osv-audit.mjs",
    "format": "pnpm -r format && biome format --write scripts"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.2.0",
      "postcss": "8.5.19",
      "protobufjs": "7.6.3"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "knip": "^6.14.2"
  }
}
